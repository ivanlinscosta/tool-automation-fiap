        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Student-ID",
              "value": "grupo-01"
            },
            {
              "name": "X-Request-ID",
              "value": "n8n-hitl-approve"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"approved_by\": \"professor@fiap.com.br\", \"decision\": \"approved\", \"decision_comment\": \"Approved in classroom simulation after human review.\" }",
        "options": {}
      },
      "id": "hitl-http-access-approve-01",
      "name": "Approve Access Request",
