            {
              "name": "X-Request-ID",
              "value": "n8n-hitl-create"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"employee_id\": $node['Webhook'].json.body.employee_id, \"resource\": $node['Webhook'].json.body.resource, \"justification\": $json.justification, \"risk\": $json.risk }",
        "options": {}
      },
      "id": "hitl-http-access-create-01",
      "name": "Create Access Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -40,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.requires_human_approval }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "hitl-if-01",
      "name": "IF Requires Approval",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "minutes"
      },
      "id": "hitl-wait-01",
      "name": "Wait for Human Review",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        560,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://localhost:8000/api/v1/access-requests/{{$node['Create Access Request'].json.request_id}}/approve",
