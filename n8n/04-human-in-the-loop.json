      "typeVersion": 4.1,
      "position": [
        860,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'auto-approved', request: $json } }}",
        "options": {}
      },
      "id": "hitl-respond-auto-01",
      "name": "Respond Auto-approved",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        560,
        120
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { employee: $node['Get Employee'].json, risk_assessment: $node['Risk Classifier Placeholder'].json, access_request: $node['Create Access Request'].json, final_decision: $json } }}",
        "options": {}
      },
      "id": "hitl-respond-final-01",
      "name": "Respond Final",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1160,
        -100
      ]
    }
