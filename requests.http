@base_url = http://localhost:8000
@student_id = grupo-01

### Root
GET {{base_url}}/
X-Student-ID: {{student_id}}
X-Request-ID: req-root-001

### Health check
GET {{base_url}}/health
X-Student-ID: {{student_id}}
X-Request-ID: req-health-001

### Get students
GET {{base_url}}/api/v1/students
X-Student-ID: {{student_id}}
X-Request-ID: req-students-001

### Get student by id
GET {{base_url}}/api/v1/students/STU001
X-Student-ID: {{student_id}}
X-Request-ID: req-student-001

### Get departments
GET {{base_url}}/api/v1/departments
X-Student-ID: {{student_id}}
X-Request-ID: req-departments-001

### Get department by category
GET {{base_url}}/api/v1/departments/digital_learning
X-Student-ID: {{student_id}}
X-Request-ID: req-department-001

### Knowledge search
GET {{base_url}}/api/v1/knowledge/search?q=acesso+ambiente&category=digital_learning
X-Student-ID: {{student_id}}
X-Request-ID: req-knowledge-search-001

### Priority check
POST {{base_url}}/api/v1/priority/check
Content-Type: application/json
X-Student-ID: {{student_id}}
X-Request-ID: req-priority-001

{
  "student_id": "STU004",
  "category": "campus_access",
  "impact": "high",
  "urgency": "high"
}

### Create request
POST {{base_url}}/api/v1/requests
Content-Type: application/json
X-Student-ID: {{student_id}}
X-Request-ID: req-create-request-001

{
  "student_id": "STU001",
  "category": "digital_learning",
  "priority": "high",
  "summary": "Acesso ao ambiente virtual bloqueado",
  "description": "Mesmo após redefinir a senha, o portal continua rejeitando o login.",
  "source": "n8n"
}

### Create interaction
POST {{base_url}}/api/v1/interactions
Content-Type: application/json
X-Student-ID: {{student_id}}
X-Request-ID: req-create-interaction-001

{
  "student_id": "STU021",
  "request_text": "Preciso da declaração de matrícula para o estágio ainda hoje.",
  "category": "academic_records",
  "response_type": "grounded_answer",
  "response_text": "Você pode emitir a declaração no portal do aluno em Serviços Acadêmicos > Documentos.",
  "knowledge_articles": ["KB010"],
  "source": "dify"
}

### Create approval request
POST {{base_url}}/api/v1/approval-requests
Content-Type: application/json
X-Student-ID: {{student_id}}
X-Request-ID: req-create-approval-001

{
  "student_id": "STU025",
  "request_type": "reissue_student_card",
  "justification": "Perdi o cartão estudantil e preciso acessar o campus para uma avaliação presencial.",
  "risk": "high"
}

### Lab - Slow
GET {{base_url}}/api/v1/lab/slow?seconds=3
X-Student-ID: {{student_id}}
X-Request-ID: req-lab-slow-001

### Lab - Error
GET {{base_url}}/api/v1/lab/error
X-Student-ID: {{student_id}}
X-Request-ID: req-lab-error-001

### Lab - Rate limit
GET {{base_url}}/api/v1/lab/rate-limit
X-Student-ID: {{student_id}}
X-Request-ID: req-lab-rate-001

### Lab - Not found
GET {{base_url}}/api/v1/lab/not-found
X-Student-ID: {{student_id}}
X-Request-ID: req-lab-not-found-001

### Lab - Validation invalid
POST {{base_url}}/api/v1/lab/validation
Content-Type: application/json
X-Student-ID: {{student_id}}
X-Request-ID: req-lab-validation-001

{
  "email": "invalid-email",
  "amount": -10
}
